ELASTICSEARCH_URL=https://your-deployment.es.example.com:443
ELASTICSEARCH_API_KEY=your-api-key
ELASTICSEARCH_INSECURE_TLS=true

# Index holding text/image/video/audio vectors (created by the app)
ELASTICSEARCH_INDEX=omni_classification_demo
# EIS endpoints (preconfigured on Elastic Inference Service)
OMNI_INFERENCE_ID=.jina-embeddings-v5-omni-small
TEXT_INFERENCE_ID=.jina-embeddings-v5-text-small
